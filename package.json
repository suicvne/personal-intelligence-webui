{
  "name": "intel-webui",
  "version": "0.1.0",
  "private": true,
  "description": "A web client for intel (personal-intelligence), alongside the SwiftUI app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server server/main.ts --dev",
    "build": "vite build",
    "start": "node server/main.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "fake-intel": "node tests/fake_intel.ts",
    "samples": "sh scripts/refresh_samples.sh",
    "snapshots": "node scripts/snapshots.ts",
    "e2e": "node scripts/e2e.ts",
    "live-check": "node scripts/live_check.ts"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
